>>SOURCE FORMAT FREE
IDENTIFICATION DIVISION.
PROGRAM-ID. STATEMENT-CORE.

DATA DIVISION.
WORKING-STORAGE SECTION.
01 SYNTHETIC-STATEMENT.
   05 GST-ON-SALES-CENTS       PIC S9(18) COMP-5 VALUE 800000.
   05 GST-CREDITS-CENTS        PIC S9(18) COMP-5 VALUE 320000.
   05 WITHHOLDING-CENTS        PIC S9(18) COMP-5 VALUE 710000.
   05 INSTALMENT-CENTS         PIC S9(18) COMP-5 VALUE 260000.

01 ASSESSMENT-RESULT.
   05 NET-CENTS                PIC S9(18) COMP-5 VALUE 0.
   05 RESULT-STATUS            PIC X(8) VALUE SPACES.
   05 RESULT-STATUS-LENGTH     PIC S9(9) COMP-5 VALUE 8.
   05 RESULT-RULE              PIC X(10) VALUE "DEMO-BR-01".
   05 RESULT-RULE-LENGTH       PIC S9(9) COMP-5 VALUE 10.

01 ADAPTER-RETURN-CODE         PIC S9(9) COMP-5 VALUE 0.

PROCEDURE DIVISION.
    COMPUTE NET-CENTS =
        (GST-ON-SALES-CENTS - GST-CREDITS-CENTS)
        + WITHHOLDING-CENTS
        + INSTALMENT-CENTS
    END-COMPUTE

    EVALUATE TRUE
        WHEN NET-CENTS > 0
            MOVE "PAYABLE " TO RESULT-STATUS
        WHEN NET-CENTS < 0
            MOVE "REFUND  " TO RESULT-STATUS
        WHEN OTHER
            MOVE "BALANCED" TO RESULT-STATUS
    END-EVALUATE

    CALL "emit_assessment_json"
        USING BY REFERENCE RESULT-STATUS
              BY REFERENCE RESULT-STATUS-LENGTH
              BY REFERENCE RESULT-RULE
              BY REFERENCE RESULT-RULE-LENGTH
              BY REFERENCE NET-CENTS
        RETURNING ADAPTER-RETURN-CODE
    END-CALL

    IF ADAPTER-RETURN-CODE NOT = 0
        DISPLAY "C adapter failed with code " ADAPTER-RETURN-CODE
            UPON STDERR
        MOVE ADAPTER-RETURN-CODE TO RETURN-CODE
    END-IF

    GOBACK.

END PROGRAM STATEMENT-CORE.
